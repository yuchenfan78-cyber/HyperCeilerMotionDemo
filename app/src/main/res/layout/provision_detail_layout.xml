<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/permission_scene"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background">

    <LinearLayout
        android:id="@+id/provision_lyt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/provision_actionbar_layout" />

        <ImageView
            android:id="@+id/preview_image"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@null"
            android:src="@drawable/provision_service_state" />

        <include layout="@layout/provision_lyt_title_layout" />

        <include layout="@layout/provision_fragment_content" />

        <TextView
            android:id="@+id/provision_confirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:background="@drawable/provision_confirm_background"
            android:text="@string/provision_continue"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:id="@+id/permission_transition_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:importantForAccessibility="no" />
</FrameLayout>
